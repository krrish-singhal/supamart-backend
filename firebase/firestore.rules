rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()  { return request.auth != null; }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin()     { return isSignedIn() && request.auth.token.role == 'ADMIN'; }
    function isPartner()   { return isSignedIn() && request.auth.token.role == 'PARTNER'; }

    // ── Public catalog: read-only to public; writes permitted for verified ADMIN. ──
    match /categories/{id} { allow read: if true;  allow write: if isAdmin(); }
    match /products/{id}   { allow read: if true;  allow write: if isAdmin(); }
    match /banners/{id}    { allow read: if true;  allow write: if isAdmin(); }
    match /offers/{id}     { allow read: if true;  allow write: if isAdmin(); }
    match /config/{id}     { allow read: if true;  allow write: if isAdmin(); }
    match /brands/{id}     { allow read: if true;  allow write: if isAdmin(); }

    // ── Users: owner read own doc + subcollections; admin all. ──
    // Direct client writes are disallowed — all mutations go through the backend Admin SDK.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /addresses/{addressId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // Push notification inbox — owner/admin reads, backend writes
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    // ── Carts: owner and admin read; client writes disallowed. ──
    match /carts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Orders: strictly authenticated and owner / assigned partner / admin access only. ──
    // Eliminates the public read vulnerability (allow read: if true).
    // Customers can read only their own orders.
    // Delivery partners can read only orders assigned to them.
    // Administrators retain full read access via verified ADMIN role claim.
    // Client writes are strictly disallowed — all mutations go through the backend Admin SDK.
    match /orders/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
        (isPartner() && ('assignedPartnerId' in resource.data) && resource.data.assignedPartnerId == request.auth.uid)
      );
      allow write: if false;
    }

    // ── Refunds: customer can read their own refund requests; admin can read all. ──
    match /refunds/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid)
      );
      allow write: if false;
    }

    // ── Issues / Reports: customer can read their own reports; admin can read all. ──
    match /issues/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid)
      );
      allow write: if false;
    }

    // ── Metrics: admin read; written by backend only. ──
    match /metrics/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Delivery partners: authenticated read (for live tracking); admin all; no client write. ──
    match /deliveryPartners/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Broadcasts: admin read; backend writes. ──
    match /broadcasts/{id} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;
    }

    // ── Admin Alerts: real-time operational alerts (low stock, stockouts) ──
    match /adminAlerts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── Idempotency keys: backend-only. ──
    match /orderIdempotency/{key} {
      allow read, write: if false;
    }

    // ── Default deny everything else. ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
