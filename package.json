{
  "name": "supermarket-backend",
  "version": "1.0.0",
  "description": "Node + Express + Firestore backend for the supermarket delivery app (JavaScript only)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/jobs/seed.js",
    "seed:products": "node src/jobs/seedProducts.js",
    "seed:brands": "node src/jobs/seedBrands.js",
    "create:admin": "node src/jobs/createAdmin.js",
    "test": "node --test test/account-deletion.test.js test/account-deletion-api.test.js test/app-regression.test.js test/delivery-area.test.js test/customer-features.test.js test/password-recovery.test.js test/reads.test.js test/security-email.test.js test/smtp-config.test.js test/pagination.test.js",
    "test:reads": "node --test test/reads.test.js",
    "test:rules": "JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 PATH=/usr/lib/jvm/java-21-openjdk-amd64/bin:$PATH firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.js\"",
    "sync:delivery-area": "node scripts/sync-delivery-area.js",
    "test:delivery": "node --test test/delivery-area.test.js",
    "smtp:check": "node scripts/check-smtp.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "1.7.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "2.4.0",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dayjs": "1.11.13",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "firebase-admin": "12.4.0",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "joi": "17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "0.15.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "nodemon": "3.1.4"
  }
}
